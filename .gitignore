# Paper draft — not for publication
paper/

# Rust build output
/target/
**/*.rs.bk

# macOS metadata
.DS_Store

# Scratch directories
scratch/

# ReasonMesh proof and trace artifacts
*.rmtrace
*.rmproof

# Benchmark run outputs (JSON results, logs, checkpoints) — regenerate with `reasonmesh benchmark`
results/
# Bare numeric checkpoint files accidentally written to repo root (e.g. --checkpoint 0)
/[0-9]
/[0-9][0-9]

# TLA+ generated and binary files
# tla2tools.jar is a tool dependency — download it separately (see tla/README.md)
tla/tla2tools.jar
# TLC disk-based state queue written during model checking
tla/states/
# TLC trace explorer outputs (generated when inspecting a counterexample in the Toolbox)
tla/*_TTrace_*.tla
tla/*_TTrace_*.bin
tla/*.dot
tla/*.out

# Hetzner provisioning — contains live IP addresses and key paths
scripts/env.sh
